    "# Prep calibrated samples dataframe\n",
    "# filter and order columns\n",
    "mean_columns=[col for col in data_merged.columns if (col.startswith(('mean')))&(col.split('_')[1][1:] in isotopologues)]\n",
    "err_columns=[col for col in data_merged.columns if (col.startswith(('err')))&(col.split('_')[1][1:] in isotopologues)]\n",
    "samples = data_merged.loc[:,mean_columns+err_columns]\n",
