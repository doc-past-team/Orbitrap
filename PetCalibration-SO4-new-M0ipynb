    "        # Calculate sum of weights\n",
    "        sum_weights = np.sum(weights, axis=0)\n",
    "        # Calculate uncertainty of the average\n",
    "        errors = (1 / sum_weights) * np.sqrt( np.sum((errs*weights)**2,axis=0) )\n",
