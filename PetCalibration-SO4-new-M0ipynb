    "# averaging\n",
    "def averaging(df):\n",
    "    df2=pd.DataFrame(columns=[col for col in df.columns]+[col+'_err' for col in df.columns], index=df.index)\n",
    "    for row in df.index:\n",
    "        for col in df.columns:\n",
    "            df2.loc[row,col] = np.mean(df.loc[row,col])\n",
    "            df2.loc[row,col+'_err'] = np.std(df.loc[row,col])\n",
    "            # df2.loc[row,col] = np.median(df.loc[row,col])\n",
    "            # df2.loc[row,col+'_err'] = np.percentile(df.loc[row,col],75)-np.percentile(df.loc[row,col],25)\n",
    "    return df2\n",
    "\n",
    "samples_cal_final =averaging(samples_cal)\n",
    "stds_cal_final = averaging(stds_cal)\n",
    "\n",
    "\n",
    "# ICP-MS data\n",
    "traditional = pd.read_excel('ICP_IRMS_DC-2011.xlsx', index_col='sample_name')\n",
    "traditional = traditional.loc[:,[col for col in traditional.columns if not col.endswith('_err')]]\n",
    "traditional.columns = [col[:4] for col in traditional.columns]\n",
    "\n",
    "# plots for ICPMS comp\n",
    "fig2,ax2=plt.subplots(4,figsize=[10,20])\n",
    "for i,delta in enumerate(['d34S','D33S','d18O','D17O']):\n",
    "    if delta in traditional.columns:\n",
    "        ax2[i].plot(traditional.index, traditional[delta]*1e3,label='traditional',c='r')\n",
    "samples_plot = samples_cal_final.loc[[row for row in samples_cal_final.index if row.startswith('DC-')]]\n",
    "deltas = ['d34S','D33S','d18O','D17O']\n",
    "for i,delta in enumerate(deltas):\n",
    "    if delta+'_M0' in samples_plot.columns:\n",
    "        ax2[i].errorbar(samples_plot.index, samples_plot[delta+'_M0']*1e3, c='b', yerr=samples_plot[delta+'_M0_err']*1e3)\n",
    "ax2[0].set_title('d34S')\n",
    "ax2[1].set_title('D33S')\n",
    "for axis in ax2:\n",
    "    axis.grid()\n",
    "    axis.legend() \n",
    "\n",
    "    \n",
    "samples_cal_final*1e3"
